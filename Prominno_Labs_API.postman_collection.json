{
	"info": {
		"name": "Prominno Labs API",
		"description": "Complete API collection for Prominno Labs - Admin & Seller",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "🔵 ADMIN",
			"item": [
				{
					"name": "1. Admin Login",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"admin@prominno.com\",\n    \"password\": \"Admin@123\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "http://localhost:5000/api/admin/login",
							"protocol": "http",
							"host": ["localhost"],
							"port": "5000",
							"path": ["api", "admin", "login"]
						},
						"description": "Login as admin. Copy the accessToken from the response and set it in the collection variable 'admin_token'."
					}
				},
				{
					"name": "2. Create Seller",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{admin_token}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"name\": \"John Doe\",\n    \"email\": \"john@test.com\",\n    \"mobileNo\": \"9876543210\",\n    \"country\": \"India\",\n    \"state\": \"Maharashtra\",\n    \"skills\": [\"React\", \"Node.js\"],\n    \"password\": \"Seller@123\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "http://localhost:5000/api/admin/sellers",
							"protocol": "http",
							"host": ["localhost"],
							"port": "5000",
							"path": ["api", "admin", "sellers"]
						},
						"description": "Create a new seller. Requires admin token in Authorization header."
					}
				},
				{
					"name": "3. List Sellers (Paginated)",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{admin_token}}"
							}
						],
						"url": {
							"raw": "http://localhost:5000/api/admin/sellers?page=1&limit=10",
							"protocol": "http",
							"host": ["localhost"],
							"port": "5000",
							"path": ["api", "admin", "sellers"],
							"query": [
								{
									"key": "page",
									"value": "1"
								},
								{
									"key": "limit",
									"value": "10"
								}
							]
						},
						"description": "Get paginated list of all sellers. Requires admin token."
					}
				}
			]
		},
		{
			"name": "🟢 SELLER",
			"item": [
				{
					"name": "4. Seller Login",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"john@test.com\",\n    \"password\": \"Seller@123\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "http://localhost:5000/api/seller/login",
							"protocol": "http",
							"host": ["localhost"],
							"port": "5000",
							"path": ["api", "seller", "login"]
						},
						"description": "Login as seller. Copy the accessToken from response and set it in collection variable 'seller_token'."
					}
				},
				{
					"name": "5. Add Product (with Brand Images)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{seller_token}}"
							}
						],
						"body": {
							"mode": "formdata",
							"formdata": [
								{
									"key": "productName",
									"value": "Mouse",
									"type": "text"
								},
								{
									"key": "description",
									"value": "A high quality computer mouse",
									"type": "text"
								},
								{
									"key": "brands",
									"value": "[{\"brandName\":\"Dell\",\"detail\":\"Dell Gaming Mouse\",\"price\":1000},{\"brandName\":\"HP\",\"detail\":\"HP Wireless Mouse\",\"price\":2000}]",
									"type": "text",
									"description": "JSON string of brands array. Count must match number of brandImages files."
								},
								{
									"key": "brandImages",
									"type": "file",
									"src": [],
									"description": "Image file for Dell brand (1st brand)"
								},
								{
									"key": "brandImages",
									"type": "file",
									"src": [],
									"description": "Image file for HP brand (2nd brand)"
								}
							]
						},
						"url": {
							"raw": "http://localhost:5000/api/seller/products",
							"protocol": "http",
							"host": ["localhost"],
							"port": "5000",
							"path": ["api", "seller", "products"]
						},
						"description": "Add a product with multiple brands. Each brand needs a corresponding image file in brandImages (in the same order). brands field is a JSON string."
					}
				},
				{
					"name": "6. List My Products (Paginated)",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{seller_token}}"
							}
						],
						"url": {
							"raw": "http://localhost:5000/api/seller/products?page=1&limit=10",
							"protocol": "http",
							"host": ["localhost"],
							"port": "5000",
							"path": ["api", "seller", "products"],
							"query": [
								{
									"key": "page",
									"value": "1"
								},
								{
									"key": "limit",
									"value": "10"
								}
							]
						},
						"description": "List only this seller's products with pagination. Requires seller token."
					}
				},
				{
					"name": "7. View Product PDF",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{seller_token}}"
							}
						],
						"url": {
							"raw": "http://localhost:5000/api/seller/products/PRODUCT_ID_HERE/pdf",
							"protocol": "http",
							"host": ["localhost"],
							"port": "5000",
							"path": ["api", "seller", "products", "PRODUCT_ID_HERE", "pdf"]
						},
						"description": "Replace PRODUCT_ID_HERE with the actual _id from the product listing response. Click 'Send and Download' in Postman to save the PDF."
					}
				},
				{
					"name": "8. Delete Product",
					"request": {
						"method": "DELETE",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{seller_token}}"
							}
						],
						"url": {
							"raw": "http://localhost:5000/api/seller/products/PRODUCT_ID_HERE",
							"protocol": "http",
							"host": ["localhost"],
							"port": "5000",
							"path": ["api", "seller", "products", "PRODUCT_ID_HERE"]
						},
						"description": "Replace PRODUCT_ID_HERE with the actual _id from the product listing. Only the seller who created the product can delete it."
					}
				}
			]
		}
	],
	"variable": [
		{
			"key": "admin_token",
			"value": "PASTE_ADMIN_TOKEN_HERE",
			"description": "Paste the accessToken from Admin Login response here"
		},
		{
			"key": "seller_token",
			"value": "PASTE_SELLER_TOKEN_HERE",
			"description": "Paste the accessToken from Seller Login response here"
		}
	]
}
